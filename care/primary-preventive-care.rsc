21:["$","div",null,{"className":"shell article-layout","children":[["$","aside",null,{"className":"article-toc","children":[["$","p",null,{"children":"Adult primary care gives you a place to discuss prevention alongside changes in your health. At Dr. Elsaadi’s independent San Bernardino practice, the relationship starts with understanding your history, current medicines and priorities."}],["$","a",null,{"className":"arrow-link","href":"/dr-elsaadi-preview/about.html","children":"Meet Dr. Elsaadi →"}]]}],["$","article",null,{"className":"guide-body","children":[[["$","section","What should a preventive visit accomplish?",{"children":[["$","h2",null,{"children":"What should a preventive visit accomplish?"}],[["$","p","Ask what is due, what can wait and how each recommendation fits your health history. Bring dates and locations of previous screenings if you have them; uncertainty about a date is a reason to locate the record, not to guess.",{"children":"Ask what is due, what can wait and how each recommendation fits your health history. Bring dates and locations of previous screenings if you have them; uncertainty about a date is a reason to locate the record, not to guess."}],["$","p","A Medicare Annual Wellness Visit and a routine physical are different services. Tell the office which you are seeking and mention any separate concerns when scheduling.",{"children":"A Medicare Annual Wellness Visit and a routine physical are different services. Tell the office which you are seeking and mention any separate concerns when scheduling."}]]]}],["$","section","A plan that develops over time",{"children":[["$","h2",null,{"children":"A plan that develops over time"}],[["$","p","Follow-up is a chance to review what was completed and resolve anything still pending. Keep an updated list of outside clinicians so reports and recommendations can be connected. If a concern needs specialty evaluation, ask what question the referral is intended to answer.",{"children":"Follow-up is a chance to review what was completed and resolve anything still pending. Keep an updated list of outside clinicians so reports and recommendations can be connected. If a concern needs specialty evaluation, ask what question the referral is intended to answer."}],["$","p","Dr. Elsaadi has cared for adults in the Inland Empire since 1991. Ongoing visits allow new concerns to be discussed alongside the larger history, rather than starting the story again each time.",{"children":"Dr. Elsaadi has cared for adults in the Inland Empire since 1991. Ongoing visits allow new concerns to be discussed alongside the larger history, rather than starting the story again each time."}]]]}]],["$","section",null,{"className":"question-note","children":[["$","h2",null,{"children":"Bring to the conversation"}],["$","ul",null,{"children":[["$","li","Photo ID, insurance card and all current medications.",{"children":"Photo ID, insurance card and all current medications."}],["$","li","Available screening or vaccination dates and outside clinician names.",{"children":"Available screening or vaccination dates and outside clinician names."}],["$","li","Your main question and any difficulty completing prior recommendations.",{"children":"Your main question and any difficulty completing prior recommendations."}]]}],["$","h3",null,{"children":"Worth asking"}],["$","ul",null,{"children":[["$","li","Which preventive steps fit my situation now?",{"children":"Which preventive steps fit my situation now?"}],["$","li","What type of visit should I schedule?",{"children":"What type of visit should I schedule?"}]]}]]}],"$L26"]}]]}]
