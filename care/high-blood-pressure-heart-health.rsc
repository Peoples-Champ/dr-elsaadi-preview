21:["$","div",null,{"className":"shell article-layout","children":[["$","aside",null,{"className":"article-toc","children":[["$","p",null,{"children":"Blood-pressure care begins with reliable information and continues with a plan that fits your overall health. Bring your readings, your medicines and the questions you have about either."}],["$","a",null,{"className":"arrow-link","href":"/dr-elsaadi-preview/about.html","children":"Meet Dr. Elsaadi →"}]]}],["$","article",null,{"className":"guide-body","children":[[["$","section","Compare readings with context",{"children":[["$","h2",null,{"children":"Compare readings with context"}],[["$","p","Home and office measurements may differ. Ask how and when to measure, what record to bring and which findings need a call. A home log is helpful when the method is consistent and the dates are clear.",{"children":"Home and office measurements may differ. Ask how and when to measure, what record to bring and which findings need a call. A home log is helpful when the method is consistent and the dates are clear."}]]]}],["$","section","Put cardiovascular questions in the larger picture",{"children":[["$","h2",null,{"children":"Put cardiovascular questions in the larger picture"}],[["$","p","A visit can address blood-pressure follow-up alongside other health concerns and medication questions. Rather than deciding what a change means yourself, bring the original records and ask what decision they help inform.",{"children":"A visit can address blood-pressure follow-up alongside other health concerns and medication questions. Rather than deciding what a change means yourself, bring the original records and ask what decision they help inform."}],["$","p","If specialist care is recommended, ask which issue needs additional evaluation and how the plan will be shared with primary care. Keep the specialist’s latest instructions with your medication list.",{"children":"If specialist care is recommended, ask which issue needs additional evaluation and how the plan will be shared with primary care. Keep the specialist’s latest instructions with your medication list."}]]]}],["$","section","Leave with a written next step",{"children":[["$","h2",null,{"children":"Leave with a written next step"}],[["$","p","Dr. Elsaadi’s long-standing adult medicine practice offers a place to connect these conversations over time. Ask for your personal targets, the timing of the next visit and a clear plan for when to call. Do not change medicine based on an internet guide or one measurement.",{"children":"Dr. Elsaadi’s long-standing adult medicine practice offers a place to connect these conversations over time. Ask for your personal targets, the timing of the next visit and a clear plan for when to call. Do not change medicine based on an internet guide or one measurement."}],["$","p","Established patients can request follow-up in Healow. A time-sensitive concern belongs in a phone call, and a medical emergency requires 911 or emergency care.",{"children":"Established patients can request follow-up in Healow. A time-sensitive concern belongs in a phone call, and a medical emergency requires 911 or emergency care."}]]]}]],["$","section",null,{"className":"question-note","children":[["$","h2",null,{"children":"Bring to the conversation"}],["$","ul",null,{"children":[["$","li","Dated readings, including both numbers and relevant notes.",{"children":"Dated readings, including both numbers and relevant notes."}],["$","li","Your monitor and cuff if you need a technique check.",{"children":"Your monitor and cuff if you need a technique check."}],"$L26"]}],"$L27","$L28"]}],"$L29"]}]]}]
