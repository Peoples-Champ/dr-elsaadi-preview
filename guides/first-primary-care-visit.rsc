26:["$","section","Choose the question you do not want to miss",{"id":"section-2","children":[["$","h2",null,{"children":"Choose the question you do not want to miss"}],[["$","p","Write one sentence beginning, “The main thing I want help with today is…” Follow it with when the concern began and how it affects a normal day. This is more useful than trying to remember every detail once you are in the exam room.",{"children":"Write one sentence beginning, “The main thing I want help with today is…” Follow it with when the concern began and how it affects a normal day. This is more useful than trying to remember every detail once you are in the exam room."}],["$","p","You can bring other questions too. At the start, ask which can be addressed today and which need their own follow-up. Before leaving, check that you understand the next step, who will contact you about results and whether another appointment is needed.",{"children":"You can bring other questions too. At the start, ask which can be addressed today and which need their own follow-up. Before leaving, check that you understand the next step, who will contact you about results and whether another appointment is needed."}]],false]}]
27:["$","section","Make the arrival easier",{"id":"section-3","children":[["$","h2",null,{"children":"Make the arrival easier"}],[["$","p","The office is at 2015 N Waterman Ave, Suite A, San Bernardino. Ask about parking, the entrance and any accessibility needs when scheduling. Dr. Elsaadi speaks English, Spanish and Arabic; office staff speaks English and Spanish.",{"children":"The office is at 2015 N Waterman Ave, Suite A, San Bernardino. Ask about parking, the entrance and any accessibility needs when scheduling. Dr. Elsaadi speaks English, Spanish and Arabic; office staff speaks English and Spanish."}],["$","p","Once your first visit is complete, provide an email address to receive your Healow invitation. There is no portal account to create before establishing care.",{"children":"Once your first visit is complete, provide an email address to receive your Healow invitation. There is no portal account to create before establishing care."}]],false]}]
