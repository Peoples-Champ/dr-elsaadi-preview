28:["$","section","Leave with responsibilities, not assumptions",{"id":"section-3","children":[["$","h2",null,{"children":"Leave with responsibilities, not assumptions"}],[["$","p","At the end, ask the patient to explain the plan in their own words, if they are comfortable doing so. Offer to write down the next steps and clarify which tasks they want help with.",{"children":"At the end, ask the patient to explain the plan in their own words, if they are comfortable doing so. Offer to write down the next steps and clarify which tasks they want help with."}],["$","p","Do not share a Healow password as a shortcut. Ask the office about approved caregiver access. Established patients use Healow for secure questions; new patients call for their first visit. Dr. Elsaadi speaks English, Spanish and Arabic, and office staff speaks English and Spanish. Mention communication needs when scheduling.",{"children":"Do not share a Healow password as a shortcut. Ask the office about approved caregiver access. Established patients use Healow for secure questions; new patients call for their first visit. Dr. Elsaadi speaks English, Spanish and Arabic, and office staff speaks English and Spanish. Mention communication needs when scheduling."}]],false]}]
