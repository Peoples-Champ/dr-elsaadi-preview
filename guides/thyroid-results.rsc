20:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Thyroid numbers and symptoms: bring both to the conversation\",\"description\":\"How to organize thyroid results, medication details and a symptom timeline before a follow-up.\",\"datePublished\":\"2026-09-20\",\"dateModified\":\"2026-09-20\",\"image\":\"https://peoples-champ.github.io/dr-elsaadi-preview/dr-elsaadi-enhanced.webp\",\"mainEntityOfPage\":\"https://peoples-champ.github.io/dr-elsaadi-preview/guides/thyroid-results.html\",\"publisher\":{\"@id\":\"https://peoples-champ.github.io/dr-elsaadi-preview/#practice\"},\"isPartOf\":{\"@type\":\"WebPage\",\"url\":\"https://peoples-champ.github.io/dr-elsaadi-preview/care/thyroid-health.html\"}}"}}]
21:["$","div",null,{"className":"shell article-layout","children":[["$","aside",null,{"className":"article-toc","children":[["$","p",null,{"className":"eyebrow","children":"In this guide"}],["$","ol",null,{"children":[["$","li","Know which test you are discussing",{"children":["$","a",null,{"href":"#section-0","children":"Know which test you are discussing"}]}],["$","li","Create two parallel timelines",{"children":["$","a",null,{"href":"#section-1","children":"Create two parallel timelines"}]}],["$","li","Ask what the follow-up is checking",{"children":["$","a",null,{"href":"#section-2","children":"Ask what the follow-up is checking"}]}],["$","li","Make instructions easy to find later",{"children":["$","a",null,{"href":"#section-3","children":"Make instructions easy to find later"}]}]]}],["$","a",null,{"className":"arrow-link","href":"/dr-elsaadi-preview/care/thyroid-health.html","children":["Explore ","thyroid health"," →"]}]]}],["$","article",null,{"className":"guide-body","children":[["$","div",null,{"className":"key-takeaway","children":[["$","strong",null,{"children":"Start here"}],["$","p",null,{"children":"Bring the actual report and a timeline of symptoms or medication changes. “My thyroid number changed” leaves out information the clinician needs."}]]}],[["$","section","Know which test you are discussing",{"id":"section-0","children":[["$","h2",null,{"children":"Know which test you are discussing"}],[["$","p","TSH is a signal from the pituitary gland that helps regulate thyroid hormone production. Free T4 measures thyroid hormone available in the blood. They describe different parts of the system and may be interpreted together.",{"children":"TSH is a signal from the pituitary gland that helps regulate thyroid hormone production. Free T4 measures thyroid hormone available in the blood. They describe different parts of the system and may be interpreted together."}],["$","p","Symptoms and test results need context. Some medicines and supplements affect testing; biotin can produce misleading thyroid results. Tell the office what you take and ask for preparation instructions. Do not stop prescribed treatment or choose a supplement pause on your own.",{"children":"Symptoms and test results need context. Some medicines and supplements affect testing; biotin can produce misleading thyroid results. Tell the office what you take and ask for preparation instructions. Do not stop prescribed treatment or choose a supplement pause on your own."}]],false]}],["$","section","Create two parallel timelines",{"id":"section-1","children":[["$","h2",null,{"children":"Create two parallel timelines"}],[["$","p","Use the left side of a page for tests and the right for what you experienced. Matching dates is more useful than trying to prove what caused a symptom.",{"children":"Use the left side of a page for tests and the right for what you experienced. Matching dates is more useful than trying to prove what caused a symptom."}]],["$","ul",null,{"className":"article-checklist","children":[["$","li","Tests: date, laboratory, test name, result, units and reference range.",{"children":"Tests: date, laboratory, test name, result, units and reference range."}],["$","li","Medicines: current name and strength, plus dates of instructed changes.",{"children":"Medicines: current name and strength, plus dates of instructed changes."}],["$","li","Symptoms: what changed, approximately when and what daily activity it affects.",{"children":"Symptoms: what changed, approximately when and what daily activity it affects."}],["$","li","Questions: the mismatch or uncertainty you want to discuss.",{"children":"Questions: the mismatch or uncertainty you want to discuss."}]]}]]}],["$","section","Ask what the follow-up is checking",{"id":"section-2","children":["$L26",["$L27","$L28"],false]}],"$L29"],"$L2a","$L2b","$L2c"]}]]}]
