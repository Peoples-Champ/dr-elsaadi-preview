22:["$","div",null,{"className":"shell article-layout","children":[["$","aside",null,{"className":"article-toc","children":[["$","p",null,{"className":"eyebrow","children":"In this guide"}],["$","ol",null,{"children":[["$","li","Name the difference you noticed",{"children":["$","a",null,{"href":"#section-0","children":"Name the difference you noticed"}]}],["$","li","Ask for a specific assignment",{"children":["$","a",null,{"href":"#section-1","children":"Ask for a specific assignment"}]}],["$","li","Bring information without editing it",{"children":["$","a",null,{"href":"#section-2","children":"Bring information without editing it"}]}],["$","li","Do not let follow-up disappear",{"children":["$","a",null,{"href":"#section-3","children":"Do not let follow-up disappear"}]}]]}],["$","a",null,{"className":"arrow-link","href":"/dr-elsaadi-preview/care/high-blood-pressure-heart-health.html","children":["Explore ","blood pressure & heart health"," →"]}]]}],["$","article",null,{"className":"guide-body","children":[["$","div",null,{"className":"key-takeaway","children":[["$","strong",null,{"children":"Start here"}],["$","p",null,{"children":"Ask what follow-up is needed and what information to bring. One reading should lead to context, not self-directed medication changes."}]]}],[["$","section","Name the difference you noticed",{"id":"section-0","children":[["$","h2",null,{"children":"Name the difference you noticed"}],[["$","p","Blood pressure can vary with the circumstances of measurement. Some people have higher readings in the office than outside it, sometimes called a white-coat effect. That possibility is something to evaluate, not a reason to dismiss an elevated reading.",{"children":"Blood pressure can vary with the circumstances of measurement. Some people have higher readings in the office than outside it, sometimes called a white-coat effect. That possibility is something to evaluate, not a reason to dismiss an elevated reading."}],["$","p","Write the office date and reading if available. If you already measure at home, bring the original record. Tell the clinician which monitor you use and how the readings were taken.",{"children":"Write the office date and reading if available. If you already measure at home, bring the original record. Tell the clinician which monitor you use and how the readings were taken."}]],false]}],["$","section","Ask for a specific assignment",{"id":"section-1","children":[["$","h2",null,{"children":"Ask for a specific assignment"}],[["$","p","“Keep an eye on it” can leave you unsure what to do. Before the visit ends, turn that into a plan with details.",{"children":"“Keep an eye on it” can leave you unsure what to do. Before the visit ends, turn that into a plan with details."}]],["$","ul",null,{"className":"article-checklist","children":[["$","li","Should I measure at home, and is my monitor suitable?",{"children":"Should I measure at home, and is my monitor suitable?"}],["$","li","At what times and for how many days?",{"children":"At what times and for how many days?"}],["$","li","When should I send the record or return?",{"children":"When should I send the record or return?"}],["$","li","What readings or symptoms should prompt a call?",{"children":"What readings or symptoms should prompt a call?"}]]}]]}],["$","section","Bring information without editing it",{"id":"section-2","children":[["$","h2",null,{"children":"Bring information without editing it"}],[["$","p","Keep readings in order and include the dates. Do not remove numbers because they look unusual. If the cuff slipped or you were interrupted, note that beside the measurement rather than trying to make the record look consistent.",{"children":"Keep readings in order and include the dates. Do not remove numbers because they look unusual. If the cuff slipped or you were interrupted, note that beside the measurement rather than trying to make the record look consistent."}],"$L27"],false]}],"$L28"],"$L29","$L2a","$L2b"]}]]}]
