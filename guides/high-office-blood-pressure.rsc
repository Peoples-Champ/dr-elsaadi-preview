27:["$","p","Describe your medication routine accurately, including whether you could obtain the prescription and whether directions are confusing. Bring current containers if your list may be outdated. These details give the clinician better questions to explore.",{"children":"Describe your medication routine accurately, including whether you could obtain the prescription and whether directions are confusing. Bring current containers if your list may be outdated. These details give the clinician better questions to explore."}]
28:["$","section","Do not let follow-up disappear",{"id":"section-3","children":[["$","h2",null,{"children":"Do not let follow-up disappear"}],[["$","p","Before leaving, confirm who will review the record and how you should provide it. Established patients can use Healow for appointment requests or questions; the practice code is FGCJBD. Ask the office how to share your log securely.",{"children":"Before leaving, confirm who will review the record and how you should provide it. Established patients can use Healow for appointment requests or questions; the practice code is FGCJBD. Ask the office how to share your log securely."}],["$","p","A portal message is not a substitute for urgent help. Call the office for time-sensitive concerns and use 911 for an emergency. Do not wait for a complete week of readings if you are worried about a current problem.",{"children":"A portal message is not a substitute for urgent help. Call the office for time-sensitive concerns and use 911 for an emergency. Do not wait for a complete week of readings if you are worried about a current problem."}]],false]}]
