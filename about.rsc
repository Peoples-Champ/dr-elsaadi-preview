e:["$","section",null,{"className":"content-section","children":["$","div",null,{"className":"shell content-grid","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"His approach"}],["$","h2",null,{"children":"A physician who knows the story behind the chart."}]]}],["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"For Dr. Elsaadi, a useful visit begins before a diagnosis is discussed. It begins with listening carefully, understanding what has changed and giving patients enough room to ask the questions they came to ask."}],["$","p",null,{"children":"That approach matters most over time. Primary care is not only about treating today’s concern; it is about recognizing patterns, coordinating care and helping each patient make informed decisions as their health evolves."}],["$","p",null,{"children":["$","strong",null,{"children":"The result is experienced adult medicine with the continuity and attention of an independent practice."}]}]]}]]}]}]
